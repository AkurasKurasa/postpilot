# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000

# Local MongoDB (Community Server or Docker) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/postpilot

# Leave empty to run with mock agents (no AI calls, good for offline demos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional overrides
# LLM_MODE=mock            # force mock agents even when a key is set
# MOCK_STEP_DELAY_MS=600   # slows mock agents down so you can watch the pipeline
# DB_MODE=memory           # run without MongoDB (data is lost on restart)
